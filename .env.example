# Operator utilities only; runtime tenant connections and Shopping project
# selectors live in TODOIST_TENANT_CATALOG_SECRET_ARN.
TODOIST_TOKEN_SECRET_ARN=arn:aws:secretsmanager:eu-west-1:000000000000:secret:placeholder
TODOIST_TENANT_CATALOG_SECRET_ARN=arn:aws:secretsmanager:eu-west-1:000000000000:secret:placeholder-catalog
SECRET_PROVIDER=aws
TODOIST_PROJECT_ID=replace-with-project-id
TODOIST_PROJECT_NAME=
REST_API_TOKEN_SECRET_ARN=arn:aws:secretsmanager:eu-west-1:000000000000:secret:placeholder
LIFE2_JWT_SIGNING_KEY_SECRET_ARN=arn:aws:secretsmanager:eu-west-1:000000000000:secret:placeholder
LIFE2_ALLOWED_ACCOUNT_ID=replace-with-life2-account-id
LOG_LEVEL=info
ALEXA_SKILL_ID=amzn1.ask.skill.replace-with-skill-id
TODOIST_API_BASE_URL=https://api.todoist.com/api/v1
COMPLETED_LOOKBACK_DAYS=90
