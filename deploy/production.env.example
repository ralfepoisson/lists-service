# Secret references and deployment identifiers only. Never place secret values here.
AWS_REGION=eu-west-1
TF_STATE_BUCKET=replace-with-owner-controlled-versioned-bucket
TF_STATE_KEY=life2/lists-service/production.tfstate
ROUTE53_ZONE_ID=replace
REST_CERTIFICATE_ARN=arn:aws:acm:eu-west-1:000000000000:certificate/replace
REST_DOMAIN_NAME=lists.life-sqrd.com
# Explicit Terraform DNS authority. Keep api_gateway until the EC2 candidate
# and public handoff are accepted. Preserve this selector for later applies.
REST_INGRESS_TARGET=api_gateway
# Set these to the separately reviewed ALB DNS identity only for alb handoff.
REST_ALB_DNS_NAME=
REST_ALB_ZONE_ID=

TODOIST_TOKEN_SECRET_ARN=arn:aws:secretsmanager:eu-west-1:000000000000:secret:replace
TODOIST_TENANT_CATALOG_SECRET_ARN=arn:aws:secretsmanager:eu-west-1:000000000000:secret:replace-catalog
TODOIST_TENANT_TOKEN_SECRET_ARNS=arn:aws:secretsmanager:eu-west-1:000000000000:secret:replace-tenant-token
REST_API_TOKEN_SECRET_ARN=arn:aws:secretsmanager:eu-west-1:000000000000:secret:replace
LIFE2_JWT_SIGNING_KEY_SECRET_ARN=arn:aws:secretsmanager:eu-west-1:000000000000:secret:replace
LIFE2_ALLOWED_ACCOUNT_ID=replace
TODOIST_PROJECT_ID=replace

# Leave Alexa blank until the real Developer Console skill exists.
ALEXA_SKILL_ID=

# Candidate deployment preserves these aliases. Update them only through the
# reviewed activate/rollback modes after candidate acceptance.
REST_ACTIVE_VERSION=
ALEXA_ACTIVE_VERSION=
