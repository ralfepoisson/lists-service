@startuml
note "Public /version exposes package SemVer and immutable Lambda/container revision." as VersionMetadata
title lists-service v1 - Implemented solution architecture

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false

note as StatusNote
  IMPLEMENTED CHECKOUT - REST PRODUCTION READ BOUNDARY VERIFIED
  Nine real Todoist mutations and a confirming read succeeded locally.
  REST Lambda v2, canonical TLS/auth, and Todoist reads verified 2026-08-08.
  Tenant catalogue/project Task Lists has local automated evidence only.
  Multitenant provider acceptance and deployment remain pending.
  Alexa and CI remain unverified.
end note

actor "Household member" as Household
component "Alexa custom skill\n(en-GB)" as Alexa
component "Personal REST client" as RestClient
component "Life2 Webapp\nShopping + Task Lists" as Webapp
component "Local Nginx\n/api/lists proxy" as LocalProxy
component "Local lists-api\nNode container" as LocalApi

cloud "AWS" {
  component "Route53 aliases\nlists.life-sqrd.com" as Route53
  component "API Gateway\nregional custom domain\nraw endpoint disabled" as ApiGateway
  component "REST active alias\naccepted version" as RestAlias
  component "Alexa active alias\naccepted version" as AlexaAlias

  package "REST Lambda entry point" as RestLambda {
    component "REST request adapter" as RestAdapter
    component "Composite authentication strategy" as AuthAdapter
    component "Constant-time automation token\n+deployment-bound accountId" as StaticAuth
    component "Life2 JWT verifier\nHS256 + principal claims" as JwtAuth
    component "Task Lists authorization\nLife2 principal only" as TaskListAuth
    file "Packaged PDFKit data\nstandard fonts + colour profile" as PdfAssets
  }

  package "Alexa Lambda entry point" as AlexaLambda {
    component "Alexa request/intent adapters" as AlexaAdapter
    component "Skill ID validator" as SkillValidator
    component "Household identity resolver" as IdentityResolver
  }

  package "Shared application package" as Application {
    component "Shopping-list + task-list\nuse-case objects\n+ bounded workspace search" as UseCases
    component "ShoppingListPrintService\ntransient active-list snapshot" as PrintUseCase
    interface "ShoppingListRepository +\nTaskListRepository" as RepositoryPort
    interface "ShoppingListPdfRenderer" as PdfPort
  }

  package "Shared domain package" as Domain {
    component "ShoppingListItem" as Item
    component "ItemContent value object" as Content
    component "Deterministic item matcher" as Matcher
    component "Domain error types" as DomainErrors
  }

  package "Shared infrastructure adapters" as Infrastructure {
    component "Tenant Shopping repository\nconfigured project" as ShoppingRepository
    component "Tenant Task Lists repository\nTodoist projects + tasks" as TaskListRepository
    component "Tenant connection catalogue\naccountId -> token secret ref" as TenantCatalog
    component "TodoistProjectResolver\nresolve or create once" as ProjectResolver
    component "Typed Todoist client\n(timeout, pagination, retry)" as TodoistClient
    component "Secret provider strategy\nAWS or read-only file" as SecretProvider
    component "Structured JSON logger" as Logger
    component "PdfKitShoppingListRenderer\nA4 attachment" as PdfRenderer
  }

  database "Secrets Manager or\nencrypted SSM" as SecretStore
  component "CloudWatch Logs\nand alarms" as CloudWatch
}

file "Local read-only\nsecret mounts" as LocalSecrets
component "Local REST composition\nfile secrets only" as LocalComposition

cloud "Todoist" {
  component "Official Todoist REST API" as TodoistApi
  database "Tenant Shopping project" as TodoistProject
  database "Tenant-visible projects\nTask Lists" as TenantProjects
}

Household --> Alexa
RestClient --> ApiGateway : HTTPS + bearer token
Webapp --> ApiGateway : HTTPS + Life2 JWT
Route53 --> ApiGateway
Webapp --> LocalProxy : local same-origin request
LocalProxy --> LocalApi
LocalApi --> LocalComposition
LocalComposition --> RestAdapter
ApiGateway --> RestAlias
RestAlias --> RestAdapter
Alexa --> AlexaAlias : signed Alexa request
AlexaAlias --> AlexaAdapter

RestAdapter --> AuthAdapter
AuthAdapter --> StaticAuth
AuthAdapter --> JwtAuth
JwtAuth --> TaskListAuth : verified accountId
StaticAuth --> TenantCatalog : configured accountId
RestAdapter --> UseCases
RestAdapter --> UseCases : POST /api/v1/search\nLife2 principal only
RestAdapter --> PrintUseCase : GET /v1/items.pdf
AlexaAdapter --> SkillValidator
AlexaAdapter --> IdentityResolver
IdentityResolver --> TenantCatalog : configured accountId
AlexaAdapter --> UseCases

UseCases --> Item
UseCases --> Content
UseCases --> Matcher
UseCases --> DomainErrors
UseCases --> RepositoryPort
PrintUseCase --> UseCases : list active items
PrintUseCase --> PdfPort
PdfRenderer ..|> PdfPort
PdfRenderer --> PdfAssets : reads at render time
ShoppingRepository ..|> RepositoryPort
TaskListRepository ..|> RepositoryPort
ShoppingRepository --> TodoistClient
TaskListRepository --> TodoistClient
ProjectResolver --> TodoistClient
ProjectResolver --> ShoppingRepository : injects Shopping project ID
TodoistClient --> TodoistApi : HTTPS
TodoistApi --> TodoistProject
TodoistApi --> TenantProjects
TaskListAuth --> TenantCatalog
TenantCatalog --> SecretProvider : tokenSecretRef
TenantCatalog --> TaskListRepository : request-scoped token
TenantCatalog --> ShoppingRepository : request-scoped token

AuthAdapter --> SecretProvider
TodoistClient --> SecretProvider
SecretProvider --> SecretStore
SecretProvider --> LocalSecrets
LocalComposition --> LocalSecrets
RestAdapter --> Logger
AlexaAdapter --> Logger
TodoistClient --> Logger
Logger --> CloudWatch

StatusNote .. UseCases

note top of RestAlias
  Canonical production origin:
  https://lists.life-sqrd.com
  Published candidate -> acceptance -> active alias.
  Rollback selects a retained accepted version.
end note

note right of UseCases
  Search enumerates only the acting tenant's visible projects
  and active tasks. It is a transient projection and emits
  allowlisted route names rather than arbitrary URLs.
end note

@enduml
