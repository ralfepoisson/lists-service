@startuml
title lists-service v1 - Implemented solution architecture

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false

note as StatusNote
  IMPLEMENTED CHECKOUT - LOCAL PROVIDER BOUNDARY VERIFIED
  Nine real Todoist mutations and a confirming read succeeded locally.
  Production proof is recorded separately from local/provider evidence.
end note

actor "Household member" as Household
component "Alexa custom skill\n(en-GB)" as Alexa
component "Personal REST client" as RestClient
component "Life2 Webapp\nShopping page" as Webapp
component "Local Nginx\n/api/lists proxy" as LocalProxy
component "Local lists-api\nNode container" as LocalApi

cloud "AWS" {
  component "Route53 aliases\nlists.life-sqrd.com" as Route53
  component "API Gateway\nregional custom domain\nraw endpoint disabled" as ApiGateway
  component "REST active alias\naccepted version" as RestAlias
  component "Alexa active alias\naccepted version" as AlexaAlias

  package "REST Lambda entry point" as RestLambda {
    component "REST request adapter" as RestAdapter
    component "Composite authentication strategy" as AuthAdapter
    component "Constant-time static token" as StaticAuth
    component "Life2 JWT verifier\nHS256 + account allow-list" as JwtAuth
  }

  package "Alexa Lambda entry point" as AlexaLambda {
    component "Alexa request/intent adapters" as AlexaAdapter
    component "Skill ID validator" as SkillValidator
    component "Household identity resolver" as IdentityResolver
  }

  package "Shared application package" as Application {
    component "Shopping-list use-case objects" as UseCases
    interface "ShoppingListRepository" as RepositoryPort
  }

  package "Shared domain package" as Domain {
    component "ShoppingListItem" as Item
    component "ItemContent value object" as Content
    component "Deterministic item matcher" as Matcher
    component "Domain error types" as DomainErrors
  }

  package "Shared infrastructure adapters" as Infrastructure {
    component "TodoistShoppingListRepository" as TodoistRepository
    component "TodoistProjectResolver\nresolve or create once" as ProjectResolver
    component "Typed Todoist client\n(timeout, pagination, retry)" as TodoistClient
    component "Secret provider strategy\nAWS or read-only file" as SecretProvider
    component "Structured JSON logger" as Logger
  }

  database "Secrets Manager or\nencrypted SSM" as SecretStore
  component "CloudWatch Logs\nand alarms" as CloudWatch
}

file "Local read-only\nsecret mounts" as LocalSecrets
component "Local REST composition\nfile secrets only" as LocalComposition

cloud "Todoist" {
  component "Official Todoist REST API" as TodoistApi
  database "Dedicated shopping-list project\n(system of record)" as TodoistProject
}

Household --> Alexa
RestClient --> ApiGateway : HTTPS + bearer token
Webapp --> ApiGateway : HTTPS + Life2 JWT
Route53 --> ApiGateway
Webapp --> LocalProxy : local same-origin request
LocalProxy --> LocalApi
LocalApi --> LocalComposition
LocalComposition --> RestAdapter
ApiGateway --> RestAlias
RestAlias --> RestAdapter
Alexa --> AlexaAlias : signed Alexa request
AlexaAlias --> AlexaAdapter

RestAdapter --> AuthAdapter
AuthAdapter --> StaticAuth
AuthAdapter --> JwtAuth
RestAdapter --> UseCases
AlexaAdapter --> SkillValidator
AlexaAdapter --> IdentityResolver
AlexaAdapter --> UseCases

UseCases --> Item
UseCases --> Content
UseCases --> Matcher
UseCases --> DomainErrors
UseCases --> RepositoryPort
TodoistRepository ..|> RepositoryPort
TodoistRepository --> TodoistClient
ProjectResolver --> TodoistClient
ProjectResolver --> TodoistRepository : injects stable project ID
TodoistClient --> TodoistApi : HTTPS
TodoistApi --> TodoistProject

AuthAdapter --> SecretProvider
TodoistClient --> SecretProvider
SecretProvider --> SecretStore
SecretProvider --> LocalSecrets
LocalComposition --> LocalSecrets
RestAdapter --> Logger
AlexaAdapter --> Logger
TodoistClient --> Logger
Logger --> CloudWatch

StatusNote .. UseCases

note top of RestAlias
  Canonical production origin:
  https://lists.life-sqrd.com
  Published candidate -> acceptance -> active alias.
  Rollback selects a retained accepted version.
end note

@enduml
