{
  "name": "@life2/lists-service",
  "version": "0.5.1",
  "private": true,
  "description": "Private Todoist-backed shopping list API and Alexa custom skill for Life2.",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:build": "node scripts/verify-build-artifacts.mjs",
    "dev:rest": "tsx src/entrypoints/local-rest.ts",
    "invoke:alexa": "tsx src/entrypoints/local-alexa.ts",
    "resolve:project": "tsx src/entrypoints/resolve-project.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:live:todoist": "tsx src/entrypoints/live-todoist-smoke.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run verify:build"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1099.0",
    "ask-sdk-core": "2.14.0",
    "ask-sdk-model": "1.86.0",
    "jsonwebtoken": "9.0.3",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.162",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.10.13",
    "@types/pdfkit": "^0.17.3",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
